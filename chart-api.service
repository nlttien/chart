[Unit]
Description=Unified Chart Market Scraper & API Server
After=network.target

[Service]
Type=simple
User=tien
WorkingDirectory=/home/tien/code/chart
ExecStart=/home/tien/code/chart/venv/bin/uvicorn server.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
